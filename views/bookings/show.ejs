<% layout("/layout/boilerplate") %>
<%
  const b = booking || {};
  const liveListing = b.listing || null;
  const snap = b.listingSnapshot || {};
  const title = liveListing?.title || snap.title || "Reserved Listing";
  const location = liveListing?.location || snap.location || "";
  const country = liveListing?.country || snap.country || "";
  const imageUrl =
    (liveListing?.image?.url && String(liveListing.image.url).trim()) ||
    (snap.imageUrl && String(snap.imageUrl).trim()) ||
    "";
  const pricing = b.pricing || {};
  const guestUsername = b.guest?.username || "Guest";
  const guestDisplayName = b.guest?.displayName || "";
  const guestLocation = b.guest?.location || "";
  const hostUsername = b.host?.username || "Host";
  const hostDisplayName = b.host?.displayName || "";
  const resolvedRole = typeof viewerRole === "string" ? viewerRole : "guest";
  const resolvedCanGuestCancel =
    typeof canGuestCancel === "boolean"
      ? canGuestCancel
      : resolvedRole === "guest" && ["pending", "confirmed"].includes(b.status);
  const resolvedHostActions =
    typeof hostActions === "object" && hostActions
      ? hostActions
      : {
          canConfirm: resolvedRole === "host" && b.status === "pending" && Boolean(liveListing),
          canCancel:
            resolvedRole === "host" &&
            ["pending", "confirmed"].includes(b.status) &&
            Boolean(liveListing),
          canComplete:
            resolvedRole === "host" && b.status === "confirmed" && Boolean(liveListing),
        };
  const resolvedActionError =
    typeof actionError === "string" && actionError ? actionError : "";
  const resolvedCancelDraft =
    typeof cancellationReasonDraft === "string" ? cancellationReasonDraft : "";
  const resolvedConfirmedAt =
    typeof confirmedAtFormatted === "string" ? confirmedAtFormatted : "";
  const resolvedCancelledAt =
    typeof cancelledAtFormatted === "string" ? cancelledAtFormatted : "";
  const resolvedCompletedAt =
    typeof completedAtFormatted === "string" ? completedAtFormatted : "";
  const noticeText =
    (typeof paymentNotice === "string" && paymentNotice) ||
    "Payment has not been collected. This reservation is not a paid booking.";

  let statusBadgeClass = "text-bg-warning";
  if (b.status === "confirmed") statusBadgeClass = "text-bg-success";
  else if (b.status === "cancelled") statusBadgeClass = "text-bg-danger";
  else if (b.status === "completed") statusBadgeClass = "text-bg-secondary";
%>

<div class="container px-0 my-4">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-9">

      <div class="account-card p-3 p-md-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 mb-3 border-bottom">
          <div>
            <span class="badge <%= statusBadgeClass %> text-uppercase mb-2"><%= b.status || "pending" %></span>
            <h1 class="h3 fw-bold mb-1">Reservation Confirmation</h1>
            <p class="small text-muted mb-0">
              Booking Reference: <strong class="text-dark"><%= b.bookingReference %></strong>
              <% if (createdAtFormatted) { %>
                &middot; Created on <span><%= createdAtFormatted %></span>
              <% } %>
            </p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <% if (resolvedRole === "guest") { %>
              <a href="/bookings" class="btn btn-outline-dark btn-sm">My Bookings</a>
            <% } else if (resolvedRole === "host") { %>
              <a href="/host/bookings" class="btn btn-outline-dark btn-sm">Host Bookings</a>
            <% } %>
            <% if (liveListing && liveListing._id) { %>
              <a href="/listings/<%= liveListing._id %>" class="btn btn-outline-dark btn-sm">View Listing</a>
            <% } %>
            <a href="/dashboard" class="btn btn-dark btn-sm">Dashboard</a>
          </div>
        </div>

        <% if (resolvedActionError) { %>
          <div id="bookingActionError" class="alert alert-danger py-2 px-3 small mb-3" role="alert">
            <i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>
            <%= resolvedActionError %>
          </div>
        <% } %>

        <div class="alert alert-info py-2 px-3 small mb-4" role="note">
          <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>
          <strong>Payment Notice:</strong> Payment has not been collected. This reservation is not a paid booking.
        </div>

        <div class="row g-4 align-items-start">
          <!-- Property & Stay Details -->
          <div class="col-12 col-md-7">
            <div class="mb-3">
              <% if (imageUrl) { %>
                <img src="<%= imageUrl %>" alt="<%= title %>" class="dashboard-thumb mb-3" />
              <% } else { %>
                <div class="dashboard-thumb-fallback mb-3">
                  <span class="small">No property image available</span>
                </div>
              <% } %>

              <h2 class="h5 fw-bold mb-1">
                <% if (liveListing && liveListing._id) { %>
                  <a href="/listings/<%= liveListing._id %>" class="text-decoration-none text-dark"><%= title %></a>
                <% } else { %>
                  <%= title %>
                <% } %>
              </h2>
              <% if (location || country) { %>
                <p class="small text-muted mb-0">
                  <i class="fa-solid fa-location-dot text-danger me-1" aria-hidden="true"></i>
                  <%= location %><% if (location && country) { %>, <% } %><%= country %>
                </p>
              <% } %>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6">
                <div class="border rounded-3 p-3 bg-light h-100">
                  <span class="small text-muted d-block">Check-in</span>
                  <strong class="d-block"><%= checkInFormatted || checkInIso %></strong>
                  <span class="small text-muted"><%= checkInIso %></span>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded-3 p-3 bg-light h-100">
                  <span class="small text-muted d-block">Check-out</span>
                  <strong class="d-block"><%= checkOutFormatted || checkOutIso %></strong>
                  <span class="small text-muted"><%= checkOutIso %></span>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded-3 p-3 bg-light h-100">
                  <span class="small text-muted d-block">Duration</span>
                  <strong><%= pricing.nights %> <%= pricing.nights === 1 ? "night" : "nights" %></strong>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded-3 p-3 bg-light h-100">
                  <span class="small text-muted d-block">Guests</span>
                  <strong><%= b.guests %> <%= b.guests === 1 ? "guest" : "guests" %></strong>
                </div>
              </div>
            </div>

            <div class="border rounded-3 p-3 bg-light">
              <h3 class="h6 fw-semibold mb-2">Reservation Participants</h3>
              <div class="small d-flex flex-column gap-1">
                <div>
                  <span class="text-muted">Guest:</span>
                  <strong>@<%= guestUsername %></strong>
                  <% if (guestDisplayName) { %>
                    <span>(<%= guestDisplayName %>)</span>
                  <% } %>
                  <% if (resolvedRole === "guest") { %>
                    <span class="badge text-bg-light border ms-1">You</span>
                  <% } %>
                  <% if (resolvedRole === "host" && guestLocation) { %>
                    <span class="text-muted">&middot; <%= guestLocation %></span>
                  <% } %>
                </div>
                <div>
                  <span class="text-muted">Host:</span>
                  <strong>@<%= hostUsername %></strong>
                  <% if (hostDisplayName) { %>
                    <span>(<%= hostDisplayName %>)</span>
                  <% } %>
                  <% if (resolvedRole === "host") { %>
                    <span class="badge text-bg-light border ms-1">You</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Frozen Server-Calculated Pricing Breakdown -->
          <div class="col-12 col-md-5">
            <div class="border rounded-4 p-3 p-md-4 bg-white">
              <h3 class="h6 fw-semibold border-bottom pb-2 mb-3">Pricing Breakdown</h3>
              <div class="d-flex flex-column gap-2 small">
                <div class="d-flex justify-content-between">
                  <span class="text-muted">Nightly price</span>
                  <span>&#8377; <%= formatINR(pricing.nightlyPrice) %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-muted">
                    &#8377; <%= formatINR(pricing.nightlyPrice) %> &times; <%= pricing.nights %> <%= pricing.nights === 1 ? "night" : "nights" %>
                  </span>
                  <span>&#8377; <%= formatINR(pricing.subtotal) %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-muted">
                    <%= pricing.taxLabel || "Estimated GST" %> (<%= pricing.taxRatePercent ?? 0 %>%)
                  </span>
                  <span>&#8377; <%= formatINR(pricing.taxAmount || 0) %></span>
                </div>
                <% if (pricing.taxDescription) { %>
                  <div class="text-muted" style="font-size: 0.78rem;"><%= pricing.taxDescription %></div>
                <% } %>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-baseline fs-6">
                  <strong class="text-dark">Final Total</strong>
                  <strong class="text-dark">&#8377; <%= formatINR(pricing.totalPrice) %> <%= pricing.currency || "INR" %></strong>
                </div>
              </div>
              <p class="small text-muted mb-0 mt-3 pt-2 border-top" style="font-size: 0.78rem;">
                <%= noticeText %> Totals are locked as a booking-time pricing snapshot and do not change if the listing's nightly rate updates later.
              </p>
            </div>
          </div>
        </div>

        <% if (b.status === "cancelled") { %>
          <div id="cancellationSummary" class="border border-danger-subtle rounded-4 p-3 p-md-4 bg-light mt-4">
            <h3 class="h6 fw-semibold text-danger mb-2">Reservation Cancelled</h3>
            <p class="small mb-1">
              Cancelled by: <strong class="text-capitalize"><%= b.cancelledBy || "guest" %></strong>
              <% if (resolvedCancelledAt) { %>
                &middot; on <span><%= resolvedCancelledAt %></span>
              <% } %>
            </p>
            <% if (b.cancellationReason) { %>
              <p class="small mb-2">
                Reason: <span class="text-body"><%= b.cancellationReason %></span>
              </p>
            <% } %>
            <p class="small text-muted mb-0">
              Reserved calendar dates have been released. Payment has not been collected, so no payment charge or refund applies.
            </p>
          </div>
        <% } else if (resolvedCanGuestCancel) { %>
          <div id="cancelSection" class="border rounded-4 p-3 p-md-4 bg-light mt-4">
            <h3 class="h6 fw-semibold mb-1">Need to cancel this reservation?</h3>
            <p class="small text-muted mb-3">
              Payment has not been collected for this reservation. Cancelling immediately releases the reserved calendar dates with no online payment charge.
            </p>
            <form
              id="cancelBookingForm"
              method="POST"
              action="/bookings/<%= b._id %>/cancel"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="mb-3">
                <label for="cancellationReasonInput" class="form-label small fw-semibold">
                  Cancellation reason (optional)
                </label>
                <input
                  id="cancellationReasonInput"
                  name="reason"
                  type="text"
                  maxlength="300"
                  value="<%= resolvedCancelDraft %>"
                  placeholder="Optional note for cancelling (max 300 characters)"
                  class="form-control form-control-sm"
                />
              </div>
              <button id="cancelBookingBtn" type="submit" class="btn btn-outline-danger btn-sm px-3">
                Cancel Reservation
              </button>
            </form>
          </div>
        <% } else if (resolvedRole === "host" && (resolvedHostActions.canConfirm || resolvedHostActions.canComplete || resolvedHostActions.canCancel)) { %>
          <div id="hostManageSection" class="border rounded-4 p-3 p-md-4 bg-light mt-4">
            <h3 class="h6 fw-semibold mb-1">Host Reservation Management</h3>
            <p class="small text-muted mb-3">
              Payment has not been collected. Updating reservation status updates calendar availability and reservation records only.
            </p>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <% if (resolvedHostActions.canConfirm) { %>
                <form
                  id="hostConfirmBookingForm"
                  method="POST"
                  action="/host/bookings/<%= b._id %>/status"
                  class="m-0"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="status" value="confirmed" />
                  <button id="hostConfirmBtn" type="submit" class="btn btn-success btn-sm px-3">
                    Confirm Reservation
                  </button>
                </form>
              <% } %>
              <% if (resolvedHostActions.canComplete) { %>
                <form
                  id="hostCompleteBookingForm"
                  method="POST"
                  action="/host/bookings/<%= b._id %>/status"
                  class="m-0"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="status" value="completed" />
                  <button id="hostCompleteBtn" type="submit" class="btn btn-dark btn-sm px-3">
                    Mark Completed
                  </button>
                </form>
              <% } %>
            </div>
            <% if (resolvedHostActions.canCancel) { %>
              <form
                id="hostCancelBookingForm"
                method="POST"
                action="/host/bookings/<%= b._id %>/status"
                class="pt-3 border-top"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="status" value="cancelled" />
                <div class="mb-2">
                  <label for="hostCancellationReasonInput" class="form-label small fw-semibold">
                    Cancel or decline reason (optional)
                  </label>
                  <input
                    id="hostCancellationReasonInput"
                    name="reason"
                    type="text"
                    maxlength="300"
                    value="<%= resolvedCancelDraft %>"
                    placeholder="Optional note for cancelling this reservation (max 300 characters)"
                    class="form-control form-control-sm"
                  />
                </div>
                <button id="hostCancelBtn" type="submit" class="btn btn-outline-danger btn-sm px-3">
                  Cancel Reservation
                </button>
              </form>
            <% } %>
          </div>
        <% } %>

        <% if (b.status === "confirmed" && resolvedConfirmedAt) { %>
          <p id="confirmedTimestampNote" class="small text-muted mt-3 mb-0">
            Confirmed on <span><%= resolvedConfirmedAt %></span>.
          </p>
        <% } else if (b.status === "completed" && resolvedCompletedAt) { %>
          <p id="completedTimestampNote" class="small text-muted mt-3 mb-0">
            Marked completed on <span><%= resolvedCompletedAt %></span>.
          </p>
        <% } %>
      </div>

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex flex-wrap gap-2">
          <% if (resolvedRole === "guest") { %>
            <a href="/bookings" class="btn btn-outline-secondary btn-sm">Back to My Bookings</a>
          <% } else if (resolvedRole === "host") { %>
            <a href="/host/bookings" class="btn btn-outline-secondary btn-sm">Back to Host Bookings</a>
          <% } %>
          <a href="/listings" class="btn btn-outline-secondary btn-sm">Explore More Listings</a>
        </div>
        <% if (liveListing && liveListing._id) { %>
          <a href="/listings/<%= liveListing._id %>" class="btn btn-outline-dark btn-sm">Return to Listing</a>
        <% } %>
      </div>

    </div>
  </div>
</div>

