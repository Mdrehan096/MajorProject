<% layout("/layout/boilerplate") %>
<%
  const userProfile = profile || {};
  const profileStats = stats || { listingsCount: 0, reviewsCount: 0 };
  const usernameText = userProfile.username || "user";
  const displayLabel = userProfile.displayName || usernameText;
  const avatarInitial = displayLabel.charAt(0).toUpperCase();
  const joinedLabel =
    userProfile.joinedAt instanceof Date && !Number.isNaN(userProfile.joinedAt.getTime())
      ? userProfile.joinedAt.toLocaleDateString("en-IN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      : "Member";
%>

<div class="container px-0 my-4">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
          <h1 class="h2 fw-bold mb-1">My Profile</h1>
          <p class="text-muted small mb-0">
            Manage your public host details and private account contact information.
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/dashboard" class="btn btn-outline-dark btn-sm px-3">
            <i class="fa-solid fa-gauge me-1" aria-hidden="true"></i>
            Go to Dashboard
          </a>
          <a href="/listings/new" class="btn btn-dark edit-btn btn-sm px-3">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
            New Listing
          </a>
        </div>
      </div>

      <div class="row g-4 align-items-start">
        <!-- Account Summary Sidebar -->
        <div class="col-12 col-lg-4">
          <section class="account-card p-4" aria-label="Account summary">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="profile-avatar" aria-hidden="true"><%= avatarInitial %></div>
              <div class="min-w-0">
                <h2 class="h5 fw-bold mb-0 text-truncate"><%= displayLabel %></h2>
                <p class="text-muted small mb-0">@<%= usernameText %></p>
              </div>
            </div>

            <% if (userProfile.location) { %>
              <p class="small text-muted mb-2">
                <i class="fa-solid fa-location-dot text-danger me-1" aria-hidden="true"></i>
                <%= userProfile.location %>
              </p>
            <% } %>

            <% if (userProfile.bio) { %>
              <p class="small text-body mb-3" style="white-space: pre-line;"><%= userProfile.bio %></p>
            <% } else { %>
              <p class="small text-muted fst-italic mb-3">
                No bio added yet. Share a short introduction for future guests and hosts.
              </p>
            <% } %>

            <hr class="my-3" />

            <div class="d-flex flex-column gap-2 small">
              <div class="d-flex justify-content-between">
                <span class="text-muted">Member since</span>
                <span class="fw-medium"><%= joinedLabel %></span>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Listings hosted</span>
                <span class="fw-semibold"><%= profileStats.listingsCount %></span>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Reviews written</span>
                <span class="fw-semibold"><%= profileStats.reviewsCount %></span>
              </div>
            </div>
          </section>
        </div>

        <!-- Editable Profile Form -->
        <div class="col-12 col-lg-8">
          <section class="account-card p-4" aria-label="Edit profile settings">
            <h2 class="h5 fw-semibold mb-1">Account Details</h2>
            <p class="text-muted small mb-4">
              Your username is permanent to keep your login session stable. Your email stays private and is never displayed on public listing pages.
            </p>

            <form
              action="/profile?_method=PUT"
              method="POST"
              class="needs-validation"
              novalidate
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

              <div class="mb-3">
                <label for="profile-username" class="form-label fw-semibold">Username</label>
                <input
                  id="profile-username"
                  type="text"
                  class="form-control"
                  value="@<%= usernameText %>"
                  disabled
                  readonly
                />
              </div>

              <div class="mb-3">
                <label for="profile-display-name" class="form-label fw-semibold">Display Name</label>
                <input
                  id="profile-display-name"
                  name="displayName"
                  type="text"
                  maxlength="80"
                  value="<%= userProfile.displayName || '' %>"
                  placeholder="How you would like your name displayed"
                  class="form-control"
                />
                <div class="form-text">Optional, up to 80 characters.</div>
              </div>

              <div class="mb-3">
                <label for="profile-email" class="form-label fw-semibold">Email Address</label>
                <input
                  id="profile-email"
                  name="email"
                  type="email"
                  maxlength="254"
                  value="<%= userProfile.email || '' %>"
                  class="form-control"
                  required
                />
                <div class="invalid-feedback">Please enter a valid email address.</div>
              </div>

              <div class="mb-3">
                <label for="profile-location" class="form-label fw-semibold">City / Region</label>
                <input
                  id="profile-location"
                  name="location"
                  type="text"
                  maxlength="100"
                  value="<%= userProfile.location || '' %>"
                  placeholder="e.g., Jaipur, India"
                  class="form-control"
                />
                <div class="form-text">Optional, up to 100 characters.</div>
              </div>

              <div class="mb-4">
                <label for="profile-bio" class="form-label fw-semibold">Bio</label>
                <textarea
                  id="profile-bio"
                  name="bio"
                  rows="4"
                  maxlength="500"
                  placeholder="Tell fellow travelers a little about yourself"
                  class="form-control"
                ><%= userProfile.bio || '' %></textarea>
                <div class="form-text">Optional, up to 500 characters.</div>
              </div>

              <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-dark edit-btn px-4">Save Changes</button>
                <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

