<% layout("layout/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="error-card p-4 p-md-5 text-center">
      <h1 class="h2 text-danger fw-bold mb-2">Error</h1>
      <h3 class="h5 text-dark fw-normal mb-4"><%= message %></h3>
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="/listings" class="btn btn-dark edit-btn px-4">Explore Listings</a>
        <a href="/privacy" class="btn btn-outline-secondary px-3">Privacy Policy</a>
      </div>
    </div>
  </div>
</div>
