<% const navQuery = typeof listingQuery !== "undefined" && listingQuery ? listingQuery : {}; %>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass"></i></a>
    <button class="navbar-toggler" 
            type="button"  
            data-bs-toggle="collapse" 
            data-bs-target="#navbarNavAltMarkup" 
     >
            <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
         <form class="d-flex my-2 my-md-0" role="search" action="/listings" method="GET">
         <input
           class="form-control me-2 search-inp"
           type="search"
           name="q"
           value="<%= navQuery.q || '' %>"
           placeholder="Search destinations"
           aria-label="Search destinations"
           maxlength="100"
         />
         <% if (navQuery.category) { %>
         <input type="hidden" name="category" value="<%= navQuery.category %>" />
         <% } %>
         <% if (navQuery.minPrice !== undefined && navQuery.minPrice !== "") { %>
         <input type="hidden" name="minPrice" value="<%= navQuery.minPrice %>" />
         <% } %>
         <% if (navQuery.maxPrice !== undefined && navQuery.maxPrice !== "") { %>
         <input type="hidden" name="maxPrice" value="<%= navQuery.maxPrice %>" />
         <% } %>
         <% if (navQuery.sort && navQuery.sort !== "newest") { %>
         <input type="hidden" name="sort" value="<%= navQuery.sort %>" />
         <% } %>
         <% if (navQuery.limit && Number(navQuery.limit) !== 12) { %>
         <input type="hidden" name="limit" value="<%= navQuery.limit %>" />
         <% } %>
         <button class="btn search-btn" type="submit"><i class="fa-brands fa-searchengin"></i>Search</button>
         </form>
      </div>

       <div class="navbar-nav ms-auto align-items-md-center">
        <a class="nav-link" href="/listings/new">Airbnb your Home</a>
        <% if(!currUser){ %>
        <a class="nav-link" href="/signup"><b>sign up</b></a>
        <a class="nav-link" href="/login"><B>log in</B></a>
        <% } %>
        <% if(currUser){ %>
        <a class="nav-link" href="/bookings">My Bookings</a>
        <a class="nav-link" href="/host/bookings">Host Bookings</a>
        <a class="nav-link" href="/dashboard">Dashboard</a>
        <a class="nav-link" href="/profile"><b>@<%= currUser.username %></b></a>
        <form action="/logout" method="POST" class="d-flex align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="nav-link btn btn-link border-0" style="text-decoration: none;"><b>log out</b></button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>