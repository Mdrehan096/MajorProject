<% layout("/layout/boilerplate") %>

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="form-card p-4 p-md-5">
      <h1 class="h3 fw-bold mb-1">Create a New Listing</h1>
      <p class="text-muted small mb-4">Share your accommodation details, base nightly rate, and location.</p>

      <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input
            id="title"
            name="listing[title]"
            placeholder="Add a catchy title"
            type="text"
            class="form-control"
            required
          />
          <div class="valid-feedback">Title looks good</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            placeholder="Describe the property, surroundings, and key amenities"
            class="form-control"
            rows="4"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Upload Listing Image</label>
          <input
            id="image"
            name="listing[image]"
            type="file"
            accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
            class="form-control"
            required
          />
          <div class="form-text">Accepted formats: PNG, JPG, JPEG, WEBP (max 5 MB).</div>
        </div>

        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label for="price" class="form-label fw-semibold">Base Price / Night (&#8377;)</label>
            <input
              id="price"
              name="listing[price]"
              placeholder="1200"
              class="form-control"
              type="number"
              min="0"
              required
            />
            <div class="invalid-feedback">Please enter a valid non-negative price.</div>
          </div>

          <div class="col-12 col-md-4">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input
              id="country"
              name="listing[country]"
              placeholder="India"
              type="text"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please enter a valid country name.</div>
          </div>

          <div class="col-12 col-md-4">
            <label for="category" class="form-label fw-semibold">Category</label>
            <select id="category" name="listing[category]" class="form-select">
              <option value="">Select category (optional)</option>
              <% for (const category of (typeof categories !== "undefined" && Array.isArray(categories) ? categories : [])) { %>
                <option value="<%= category.slug %>"><%= category.label %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="mt-3 mb-4">
          <label for="location" class="form-label fw-semibold">Location</label>
          <input
            id="location"
            name="listing[location]"
            placeholder="Jaipur, Rajasthan"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid location.</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-dark add-btn px-4" type="submit">Add Listing</button>
          <a href="/listings" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
