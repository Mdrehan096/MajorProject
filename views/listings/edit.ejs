<% layout("/layout/boilerplate") %>

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="form-card p-4 p-md-5">
      <h1 class="h3 fw-bold mb-1">Edit your Listing</h1>
      <p class="text-muted small mb-4">Update your stay details, category, pricing, or property image.</p>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=PUT"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input
            id="title"
            name="listing[title]"
            value="<%= listing.title %>"
            type="text"
            class="form-control"
            required
          />
          <div class="valid-feedback">Title looks good</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            class="form-control"
            rows="4"
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <div class="mb-3">
          <span class="form-label fw-semibold d-block">Current Listing Image</span>
          <% if (typeof originalImageUrl === "string" && originalImageUrl.trim()) { %>
            <img
              src="<%= originalImageUrl %>"
              alt="<%= listing.title %>"
              class="img-fluid rounded border"
              style="max-width: 220px;"
            />
          <% } else { %>
            <p class="small text-muted mb-0">No image uploaded yet.</p>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Upload New Image (optional)</label>
          <input
            id="image"
            name="listing[image]"
            type="file"
            accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
            class="form-control"
          />
        </div>

        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label for="price" class="form-label fw-semibold">Base Price / Night (&#8377;)</label>
            <input
              id="price"
              name="listing[price]"
              value="<%= listing.price %>"
              type="number"
              min="0"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please enter a valid non-negative price.</div>
          </div>

          <div class="col-12 col-md-4">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input
              id="country"
              name="listing[country]"
              value="<%= listing.country %>"
              type="text"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please enter a valid country name.</div>
          </div>

          <div class="col-12 col-md-4">
            <label for="category" class="form-label fw-semibold">Category</label>
            <select id="category" name="listing[category]" class="form-select">
              <option value="">No category</option>
              <% for (const category of (typeof categories !== "undefined" && Array.isArray(categories) ? categories : [])) { %>
                <option value="<%= category.slug %>" <%= listing.category === category.slug ? 'selected' : '' %>>
                  <%= category.label %>
                </option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="mt-3 mb-4">
          <label for="location" class="form-label fw-semibold">Location</label>
          <input
            id="location"
            name="listing[location]"
            value="<%= listing.location %>"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid location.</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-dark edit-btn px-4" type="submit">Save Changes</button>
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
