# Wanderlust Environment Configuration Example
# Copy this file to .env for local development and populate your own values.
# Never commit your .env file or real credentials to version control.

# Server & Runtime
NODE_ENV=development
PORT=8080
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Database (MongoDB Atlas or Replica-Set MongoDB URI required for multi-document transactions)
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
DB_DNS_SERVERS=8.8.8.8,8.8.4.4
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=45000

# Session & Cryptography
# Required. In NODE_ENV=production, SECRET must be at least 32 characters and non-default.
SECRET=replace_with_a_cryptographically_random_secret_at_least_32_characters

# Cloudinary Media Storage (optional in local dev with placeholder fallbacks; required for live image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
CLOUD_FOLDER=wanderlust_DEV

# Mapbox Geocoding & Map Rendering (optional fallback in local dev; required for forward geocoding and interactive maps)
MAP_TOKEN=your_mapbox_public_access_token

# Authentication Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Pricing, Tax & Booking Constraints
# TAX_MODE: indian_gst_slabs | flat | none
TAX_MODE=indian_gst_slabs
# TAX_RATE: Required when TAX_MODE=flat (0-100)
TAX_RATE=
TAX_LABEL=Estimated GST
MAX_STAY_NIGHTS=90
BOOKING_DEFAULT_MAX_GUESTS=8
BOOKING_TX_MAX_RETRIES=4
